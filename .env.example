# A donde proxea el dev server las requests a /api y /uploads. Lo lee
# vite.config.ts. El codigo hace fetch("/api/...") relativo, asi que esta
# variable solo aplica en desarrollo.
API_PROXY_TARGET=http://localhost:8080

# La app se sirve desde <host>/carwash/, no desde la raiz. Vite lo quiere con
# barra final; de ahi sale import.meta.env.BASE_URL, que App.tsx le pasa como
# base al router de wouter. Mismo valor que BASE_PATH en el workflow.
BASE_PATH=/carwash/

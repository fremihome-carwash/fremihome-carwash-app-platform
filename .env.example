# URL del backend (new-server). La lee vite.config.ts para proxear /api y
# /uploads. El codigo del frontend hace fetch("/api/...") relativo, asi que
# esta variable solo aplica en desarrollo. Mismo nombre que en cw, aunque ahi
# el cliente la use como URL absoluta.
EXPO_PUBLIC_API_URL=http://localhost:8080

# La app se sirve desde <host>/carwash/, no desde la raiz. Vite lo quiere con
# barra final; de ahi sale import.meta.env.BASE_URL, que App.tsx le pasa como
# base al router de wouter. Mismo valor que BASE_PATH en el workflow.
BASE_PATH=/carwash/
